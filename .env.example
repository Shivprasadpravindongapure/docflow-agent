# PostgreSQL development database connection. Keep real credentials in ignored local .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
UPLOAD_DIR=./uploads
PORT=4000
HOST=127.0.0.1
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AGENT_BASE_URL=http://127.0.0.1:4100
WORKER_POLL_SECONDS=1
SIMULATOR_API_URL=http://127.0.0.1:4000
SIMULATOR_EMAIL=synthetic-simulator@example.test
SIMULATOR_PASSWORD=replace-with-a-local-synthetic-account-password
